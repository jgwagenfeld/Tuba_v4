GROUND0 = AFFE_CHAR_MECA(MODELE=MODELE, DDL_IMPO=_F(GROUP_NO='GROUND_0',DX=0.,DY=0.,DZ=0.))
GROUND1 = AFFE_CHAR_MECA(MODELE=MODELE, DDL_IMPO=_F(GROUP_NO='GROUND_3',DX=0.,DY=0.,DZ=0.))
GROUND2 = AFFE_CHAR_MECA(MODELE=MODELE, LIAISON_DDL=(_F(GROUP_NO=('GD3F8976','GN_N39'),DDL=('DX','DX'),COEF_MULT=(1.,-1.),COEF_IMPO=0.),_F(GROUP_NO=('GD3F8976','GN_N39'),DDL=('DY','DY'),COEF_MULT=(1.,-1.),COEF_IMPO=0.),_F(GROUP_NO=('GD3F8976','GN_N39'),DDL=('DZ','DZ'),COEF_MULT=(1.,-1.),COEF_IMPO=0.)))
GROUND3 = AFFE_CHAR_MECA(MODELE=MODELE, LIAISON_DDL=(_F(GROUP_NO=('GEE3684B','GN_N40'),DDL=('DX','DX'),COEF_MULT=(1.,-1.),COEF_IMPO=0.),_F(GROUP_NO=('GEE3684B','GN_N40'),DDL=('DY','DY'),COEF_MULT=(1.,-1.),COEF_IMPO=0.),_F(GROUP_NO=('GEE3684B','GN_N40'),DDL=('DZ','DZ'),COEF_MULT=(1.,-1.),COEF_IMPO=0.)))
GROUND4 = AFFE_CHAR_MECA(MODELE=MODELE, LIAISON_DDL=(_F(GROUP_NO=('G7AE05B8','GN_N42'),DDL=('DX','DX'),COEF_MULT=(1.,-1.),COEF_IMPO=0.),_F(GROUP_NO=('G7AE05B8','GN_N42'),DDL=('DY','DY'),COEF_MULT=(1.,-1.),COEF_IMPO=0.),_F(GROUP_NO=('G7AE05B8','GN_N42'),DDL=('DZ','DZ'),COEF_MULT=(1.,-1.),COEF_IMPO=0.)))
GROUND5 = AFFE_CHAR_MECA(MODELE=MODELE, LIAISON_DDL=(_F(GROUP_NO=('G674F58A','GN_N43'),DDL=('DX','DX'),COEF_MULT=(1.,-1.),COEF_IMPO=0.),_F(GROUP_NO=('G674F58A','GN_N43'),DDL=('DY','DY'),COEF_MULT=(1.,-1.),COEF_IMPO=0.),_F(GROUP_NO=('G674F58A','GN_N43'),DDL=('DZ','DZ'),COEF_MULT=(1.,-1.),COEF_IMPO=0.)))
# ----- Gravity -----
GRAVITY = AFFE_CHAR_MECA(
    MODELE=MODELE,
    PESANTEUR=_F(
        GRAVITE=9.81,
        DIRECTION=(0.0, 0.0, -1.0),
    ),
);

# ----- Internal pressure -----
PRESSURE = AFFE_CHAR_MECA(
    MODELE=MODELE,
    FORCE_TUYAU=_F(
        GROUP_MA='AllPipes',
        PRES=4.000000E+06,
    ),
);

# ----- Concentrated nodal forces -----
POINT_FORCE = AFFE_CHAR_MECA(
    MODELE=MODELE,
