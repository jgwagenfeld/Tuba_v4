        _F(CHARGE=BC_13),
        _F(CHARGE=BC_14),
        _F(CHARGE=BC_15),
        _F(CHARGE=BC_16),
        _F(CHARGE=BC_17),
        _F(CHARGE=BC_18),
        _F(CHARGE=GROUND0),
        _F(CHARGE=GROUND1),
        _F(CHARGE=GROUND2),
        _F(CHARGE=GROUND3),
        _F(CHARGE=GROUND4),
        _F(CHARGE=GROUND5),
        _F(CHARGE=GRAVITY),
        _F(CHARGE=PRESSURE),
        _F(CHARGE=POINT_FORCE),
    ),
    COMPORTEMENT=(
        _F(
            GROUP_MA=('AllPipes', 'G_TUBE',),
            RELATION='ELAS',
        ),
        _F(GROUP_MA='GA72D480', RELATION='DIS_CHOC', RESI_INTE=1e-9),
        _F(GROUP_MA='G2F811FE', RELATION='DIS_CHOC', RESI_INTE=1e-9),
        _F(GROUP_MA='GBB23ACA', RELATION='DIS_CHOC', RESI_INTE=1e-9),
        _F(GROUP_MA='G74A7F8A', RELATION='DIS_CHOC', RESI_INTE=1e-9),
        _F(GROUP_MA='G0FA7226', RELATION='DIS_CHOC', RESI_INTE=1e-9),
        _F(GROUP_MA='GB55BD6C', RELATION='DIS_CHOC', RESI_INTE=1e-9),
    ),
    INCREMENT=_F(
        LIST_INST=times,
    ),
    CONVERGENCE=_F(RESI_GLOB_RELA=1e-8, ITER_GLOB_MAXI=50),
    METHODE='NEWTON',
);

# ----- Derived fields -----
RESU = CALC_CHAMP(
    reuse=RESU,
    RESULTAT=RESU,
    CONTRAINTE=('EFGE_ELNO', 'SIEF_ELNO'),
    CRITERES=('SIEQ_ELGA', 'SIEQ_ELNO'),
    FORCE='REAC_NODA',
);

# ----- Write MED results file -----
IMPR_RESU(
    FORMAT='MED',
    UNITE=80,
    RESU=_F(
        RESULTAT=RESU,
        INST=1.0,
        CARA_ELEM=CARA,
        NOM_CHAM=('DEPL', 'SIEQ_ELGA', 'SIEQ_ELNO', 'EFGE_ELNO', 'REAC_NODA'),
    ),
);

