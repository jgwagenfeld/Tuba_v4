        ),
        _F(
            GROUP_NO='GN_N5',
            FX=0.00000000E+00,
            FY=0.00000000E+00,
            FZ=-2.70000000E+03,
            MX=0.00000000E+00,
            MY=0.00000000E+00,
            MZ=0.00000000E+00,
