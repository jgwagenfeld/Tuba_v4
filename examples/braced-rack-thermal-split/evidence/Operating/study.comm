# ----- Thermal expansion -----
TEMP_REF_FIELD = CREA_CHAMP(
    TYPE_CHAM='NOEU_TEMP_R',
    OPERATION='AFFE',
    MAILLAGE=MAIL,
    AFFE=_F(
        TOUT='OUI',
        NOM_CMP='TEMP',
        VALE=2.000000E+01,
    ),
);

TEMP_HOT_FIELD = CREA_CHAMP(
    TYPE_CHAM='NOEU_TEMP_R',
    OPERATION='AFFE',
    MODELE=MODELE,
    AFFE=(
        _F(
            TOUT='OUI',
            NOM_CMP='TEMP',
            VALE=1.200000E+02,
        ),
        _F(
            GROUP_MA=('G865AF37', 'G8DCD4C6', 'GF75806A', 'G5E41366', 'G93D04F2', 'G3742589', 'G868686F', 'G4913DE3',),
            NOM_CMP='TEMP',
            VALE=4.000000E+02,
        ),
    ),
);

TEMP_EVOL = CREA_RESU(
    OPERATION='AFFE',
    TYPE_RESU='EVOL_THER',
    NOM_CHAM='TEMP',
    AFFE=(
        _F(CHAM_GD=TEMP_REF_FIELD, INST=0.0),
        _F(CHAM_GD=TEMP_HOT_FIELD, INST=1.0),
    ),
);

CHMAT = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(
        _F(
            GROUP_MA='G5AF7883',
            MATER=MAT_STEEL,
        ),
_F(GROUP_MA='GA72D480',MATER=CM0),
_F(GROUP_MA='G2F811FE',MATER=CM1),
_F(GROUP_MA='GBB23ACA',MATER=CM2),
_F(GROUP_MA='G74A7F8A',MATER=CM3),
_F(GROUP_MA='G0FA7226',MATER=CM4),
_F(GROUP_MA='GB55BD6C',MATER=CM5),
    ),
    AFFE_VARC=_F(
        GROUP_MA=('AllPipes', 'G_TUBE'),
        NOM_VARC='TEMP',
        EVOL=TEMP_EVOL,
        NOM_CHAM='TEMP',
        VALE_REF=2.000000E+01,
    ),
);

# ----- Solve -----
lst_inst = DEFI_LIST_REEL(DEBUT=0.0, INTERVALLE=_F(JUSQU_A=1.0, NOMBRE=10));
times = DEFI_LIST_INST(DEFI_LIST=_F(LIST_INST=lst_inst));

RESU = STAT_NON_LINE(
    MODELE=MODELE,
    CHAM_MATER=CHMAT,
    CARA_ELEM=CARA,
    EXCIT=(
        _F(CHARGE=BC_0),
        _F(CHARGE=BC_1),
        _F(CHARGE=BC_2),
        _F(CHARGE=BC_3),
        _F(CHARGE=BC_4),
