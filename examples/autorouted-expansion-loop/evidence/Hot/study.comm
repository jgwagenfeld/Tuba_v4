DEBUT(PAR_LOT='NON');

# ----- Read mesh -----
MAIL0 = LIRE_MAILLAGE(FORMAT='ASTER',
                      UNITE=20);

MAIL = MAIL0;

# ----- Model definition -----
MODELE = AFFE_MODELE(
    MAILLAGE=MAIL,
    AFFE=(
        _F(
            GROUP_MA='AllPipes',
            PHENOMENE='MECANIQUE',
            MODELISATION='TUYAU_3M',
        ),
        _F(
            GROUP_MA='GA72D480',
            PHENOMENE='MECANIQUE',
            MODELISATION='DIS_T',
        ),
        _F(
            GROUP_MA='G1CB0E9C',
            PHENOMENE='MECANIQUE',
            MODELISATION='DIS_T',
        ),
    ),
);

# ----- Material definitions -----
MAT_STEEL = DEFI_MATERIAU(
    ELAS=_F(
        E=2.100000E+11,
        NU=3.000000E-01,
        RHO=7.850000E+03,
        ALPHA=1.200000E-05,
    ),
);

CM0 = DEFI_MATERIAU(DIS_CONTACT=_F(RIGI_NOR=10000000000.0,RIGI_TAN=100000000.0,COULOMB=0.0,DIST_1=1.0))
CM1 = DEFI_MATERIAU(DIS_CONTACT=_F(RIGI_NOR=10000000000.0,RIGI_TAN=100000000.0,COULOMB=0.0,DIST_1=1.0))
# ----- Material assignment -----
CHMAT = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(
        _F(
            GROUP_MA='G76B55C9',
            MATER=MAT_STEEL,
        ),
_F(GROUP_MA='GA72D480',MATER=CM0),
_F(GROUP_MA='G1CB0E9C',MATER=CM1),
    ),
);

# ----- Cross-section properties -----
CARA = AFFE_CARA_ELEM(
    MODELE=MODELE,
    POUTRE=(
        _F(
            GROUP_MA='SEC_DN80',
            SECTION='CERCLE',
            CARA=('R', 'EP'),
            VALE=(4.44500000E-02, 5.49000000E-03),
        ),
        _F(
            GROUP_MA='G8652C19',
            SECTION='CERCLE',
            CARA=('R', 'EP'),
            VALE=(4.44500000E-02, 5.49000000E-03),
        ),
        _F(GROUP_MA='G8652C19', SECTION='COUDE'),
        _F(
            GROUP_MA='G21F400B',
            SECTION='CERCLE',
            CARA=('R', 'EP'),
            VALE=(4.44500000E-02, 5.49000000E-03),
        ),
        _F(GROUP_MA='G21F400B', SECTION='COUDE'),
        _F(
            GROUP_MA='GD57111F',
            SECTION='CERCLE',
            CARA=('R', 'EP'),
            VALE=(4.44500000E-02, 5.49000000E-03),
        ),
        _F(GROUP_MA='GD57111F', SECTION='COUDE'),
        _F(
            GROUP_MA='G95148D5',
            SECTION='CERCLE',
            CARA=('R', 'EP'),
            VALE=(4.44500000E-02, 5.49000000E-03),
        ),
        _F(GROUP_MA='G95148D5', SECTION='COUDE'),
    ),
    DISCRET=(
_F(GROUP_MA='GA72D480',REPERE='LOCAL',CARA='K_T_D_L',VALE=(0.,0.,0.)),
_F(GROUP_MA='G1CB0E9C',REPERE='LOCAL',CARA='K_T_D_L',VALE=(0.,0.,0.)),
    ),
    ORIENTATION=(
_F(GROUP_MA='GA72D480',CARA='VECT_Y',VALE=(1.0, 0.0, 0.0)),
_F(GROUP_MA='G1CB0E9C',CARA='VECT_Y',VALE=(1.0, 0.0, 0.0)),
        _F(
            GROUP_NO='G06D7539',
            CARA='GENE_TUYAU',
            VALE=(0.00000000E+00, 0.00000000E+00, 1.00000000E+00),
        ),
    ),
);

# ----- Boundary conditions -----
BC_0 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N1',
        WO=0.0,
    ),
);

BC_1 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N10',
        WO=0.0,
    ),
);

BC_2 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N0',
        BLOCAGE=('DEPLACEMENT', 'ROTATION'),
        WO=0.0,
    ),
);

BC_3 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N11',
        BLOCAGE=('DEPLACEMENT', 'ROTATION'),
        WO=0.0,
    ),
);

GROUND0 = AFFE_CHAR_MECA(MODELE=MODELE, DDL_IMPO=_F(GROUP_NO='GROUND_0',DX=0.,DY=0.,DZ=0.))
GROUND1 = AFFE_CHAR_MECA(MODELE=MODELE, DDL_IMPO=_F(GROUP_NO='GROUND_1',DX=0.,DY=0.,DZ=0.))
# ----- Gravity -----
GRAVITY = AFFE_CHAR_MECA(
    MODELE=MODELE,
    PESANTEUR=_F(
        GRAVITE=9.81,
        DIRECTION=(0.0, 0.0, -1.0),
    ),
);

# ----- Internal pressure -----
PRESSURE = AFFE_CHAR_MECA(
    MODELE=MODELE,
    FORCE_TUYAU=_F(
        GROUP_MA='AllPipes',
        PRES=1.200000E+06,
    ),
);

# ----- Thermal expansion -----
TEMP_REF_FIELD = CREA_CHAMP(
    TYPE_CHAM='NOEU_TEMP_R',
    OPERATION='AFFE',
    MAILLAGE=MAIL,
    AFFE=_F(
        TOUT='OUI',
        NOM_CMP='TEMP',
        VALE=2.000000E+01,
    ),
);

TEMP_HOT_FIELD = CREA_CHAMP(
    TYPE_CHAM='NOEU_TEMP_R',
    OPERATION='AFFE',
    MAILLAGE=MAIL,
    AFFE=_F(
        TOUT='OUI',
        NOM_CMP='TEMP',
        VALE=1.800000E+02,
    ),
);

TEMP_EVOL = CREA_RESU(
    OPERATION='AFFE',
    TYPE_RESU='EVOL_THER',
    NOM_CHAM='TEMP',
    AFFE=(
        _F(CHAM_GD=TEMP_REF_FIELD, INST=0.0),
        _F(CHAM_GD=TEMP_HOT_FIELD, INST=1.0),
    ),
);

CHMAT = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(
        _F(
            GROUP_MA='G76B55C9',
            MATER=MAT_STEEL,
        ),
_F(GROUP_MA='GA72D480',MATER=CM0),
_F(GROUP_MA='G1CB0E9C',MATER=CM1),
    ),
    AFFE_VARC=_F(
        GROUP_MA=('AllPipes',),
        NOM_VARC='TEMP',
        EVOL=TEMP_EVOL,
        NOM_CHAM='TEMP',
        VALE_REF=2.000000E+01,
    ),
);

# ----- Solve -----
lst_inst = DEFI_LIST_REEL(DEBUT=0.0, INTERVALLE=_F(JUSQU_A=1.0, NOMBRE=10));
times = DEFI_LIST_INST(DEFI_LIST=_F(LIST_INST=lst_inst));

RESU = STAT_NON_LINE(
    MODELE=MODELE,
    CHAM_MATER=CHMAT,
    CARA_ELEM=CARA,
    EXCIT=(
        _F(CHARGE=BC_0),
        _F(CHARGE=BC_1),
        _F(CHARGE=BC_2),
        _F(CHARGE=BC_3),
        _F(CHARGE=GROUND0),
        _F(CHARGE=GROUND1),
        _F(CHARGE=GRAVITY),
        _F(CHARGE=PRESSURE),
    ),
    COMPORTEMENT=(
        _F(
            GROUP_MA='AllPipes',
            RELATION='ELAS',
        ),
        _F(GROUP_MA='GA72D480', RELATION='DIS_CHOC', RESI_INTE=1e-9),
        _F(GROUP_MA='G1CB0E9C', RELATION='DIS_CHOC', RESI_INTE=1e-9),
    ),
    INCREMENT=_F(
        LIST_INST=times,
    ),
    METHODE='NEWTON',
);

# ----- Derived fields -----
RESU = CALC_CHAMP(
    reuse=RESU,
    RESULTAT=RESU,
    CONTRAINTE=('EFGE_ELNO', 'SIEF_ELNO'),
    CRITERES=('SIEQ_ELGA', 'SIEQ_ELNO'),
    FORCE='REAC_NODA',
);

# ----- Write MED results file -----
IMPR_RESU(
    FORMAT='MED',
    UNITE=80,
    RESU=_F(
        RESULTAT=RESU,
        INST=1.0,
        CARA_ELEM=CARA,
        NOM_CHAM=('DEPL', 'SIEQ_ELGA', 'SIEQ_ELNO', 'EFGE_ELNO', 'REAC_NODA'),
    ),
);

# ----- Text table for EFGE_ELNO -----
TAB_EFFO = CREA_TABLE(
    RESU=_F(
        RESULTAT=RESU,
        NOM_CHAM='EFGE_ELNO',
        TOUT='OUI',
        NOM_CMP=('N', 'VY', 'VZ', 'MT', 'MFY', 'MFZ'),
        INST=1.0,
    ),
);

IMPR_TABLE(
    TABLE=TAB_EFFO,
    UNITE=38,
    FORMAT='TABLEAU',
    FORMAT_R='1PE24.16',
    SEPARATEUR=',',
);

# ----- Text table for DEPL -----
TAB_DEPL = CREA_TABLE(
    RESU=_F(
        RESULTAT=RESU,
        NOM_CHAM='DEPL',
        TOUT='OUI',
        NOM_CMP=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'),
        INST=1.0,
    ),
);

IMPR_TABLE(
    TABLE=TAB_DEPL,
    UNITE=39,
    FORMAT='TABLEAU',
    FORMAT_R='1PE24.16',
    SEPARATEUR=',',
);

# ----- Text table for REAC_NODA -----
TAB_REAC = CREA_TABLE(
    RESU=_F(
        RESULTAT=RESU,
        NOM_CHAM='REAC_NODA',
        TOUT='OUI',
        NOM_CMP=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'),
        INST=1.0,
    ),
);

IMPR_TABLE(
    TABLE=TAB_REAC,
    UNITE=40,
    FORMAT='TABLEAU',
    FORMAT_R='1PE24.16',
    SEPARATEUR=',',
);

# ----- Text table for SIEQ_ELNO -----
TAB_SIEQ = CREA_TABLE(
    RESU=_F(
        RESULTAT=RESU,
        NOM_CHAM='SIEQ_ELNO',
        TOUT='OUI',
        NOM_CMP=('VMIS',),
        INST=1.0,
    ),
);

IMPR_TABLE(
    TABLE=TAB_SIEQ,
    UNITE=41,
    FORMAT='TABLEAU',
    FORMAT_R='1PE24.16',
    SEPARATEUR=',',
);

import json
contact_rows = []
CT = CREA_TABLE(RESU=_F(RESULTAT=RESU,GROUP_MA='GA72D480',NOM_CHAM='SIEF_ELGA',TOUT_CMP='OUI',INST=1.0))
forces = CT.EXTR_TABLE().values()
VT = CREA_TABLE(RESU=_F(RESULTAT=RESU,GROUP_MA='GA72D480',NOM_CHAM='VARI_ELGA',TOUT_CMP='OUI',INST=1.0))
variables = VT.EXTR_TABLE().values()
if not all(f'V{i}' in variables for i in range(1,11)): raise RuntimeError('Native friction requires the qualified ten-variable DIS_CHOC layout.')
iv = {float(t): i for i,t in enumerate(variables["INST"]) if variables["POINT"][i] == 1}
for i,t in enumerate(forces["INST"]):
    if forces["POINT"][i] != 1: continue
    j = iv[float(t)]
    contact_rows.append(dict(support_id='support_0',instant=float(t),N=forces["N"][i],VY=forces["VY"][i],VZ=forces["VZ"][i],slip_y=variables["V5"][j],slip_z=variables["V6"][j],status=variables["V4"][j]))
CT = CREA_TABLE(RESU=_F(RESULTAT=RESU,GROUP_MA='G1CB0E9C',NOM_CHAM='SIEF_ELGA',TOUT_CMP='OUI',INST=1.0))
forces = CT.EXTR_TABLE().values()
VT = CREA_TABLE(RESU=_F(RESULTAT=RESU,GROUP_MA='G1CB0E9C',NOM_CHAM='VARI_ELGA',TOUT_CMP='OUI',INST=1.0))
variables = VT.EXTR_TABLE().values()
if not all(f'V{i}' in variables for i in range(1,11)): raise RuntimeError('Native friction requires the qualified ten-variable DIS_CHOC layout.')
iv = {float(t): i for i,t in enumerate(variables["INST"]) if variables["POINT"][i] == 1}
for i,t in enumerate(forces["INST"]):
    if forces["POINT"][i] != 1: continue
    j = iv[float(t)]
    contact_rows.append(dict(support_id='support_1',instant=float(t),N=forces["N"][i],VY=forces["VY"][i],VZ=forces["VZ"][i],slip_y=variables["V5"][j],slip_z=variables["V6"][j],status=variables["V4"][j]))
with open('fort.42','w') as stream: json.dump(contact_rows,stream,allow_nan=False)
FIN();