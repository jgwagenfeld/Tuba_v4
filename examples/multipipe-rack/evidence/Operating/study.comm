import json
contact_rows = []
CT = CREA_TABLE(RESU=_F(RESULTAT=RESU,GROUP_MA='G21F7E75',NOM_CHAM='SIEF_ELGA',TOUT_CMP='OUI',INST=1.0))
forces = CT.EXTR_TABLE().values()
VT = CREA_TABLE(RESU=_F(RESULTAT=RESU,GROUP_MA='G21F7E75',NOM_CHAM='VARI_ELGA',TOUT_CMP='OUI',INST=1.0))
variables = VT.EXTR_TABLE().values()
if not all(f'V{i}' in variables for i in range(1,11)): raise RuntimeError('Native friction requires the qualified ten-variable DIS_CHOC layout.')
iv = {float(t): i for i,t in enumerate(variables["INST"]) if variables["POINT"][i] == 1}
for i,t in enumerate(forces["INST"]):
    if forces["POINT"][i] != 1: continue
    j = iv[float(t)]
    contact_rows.append(dict(support_id='support_10',instant=float(t),N=forces["N"][i],VY=forces["VY"][i],VZ=forces["VZ"][i],slip_y=variables["V5"][j],slip_z=variables["V6"][j],status=variables["V4"][j]))
