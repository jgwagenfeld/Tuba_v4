solid imported_component_demo
  facet normal 0 0 1
    outer loop
      vertex 0 0 0
      vertex 0.4 0 0
      vertex 0 0.3 0
    endloop
  endfacet
  facet normal 0 -1 0
    outer loop
      vertex 0 0 0
      vertex 0 0.3 0
      vertex 0.2 0.1 0.25
    endloop
  endfacet
  facet normal 1 1 1
    outer loop
      vertex 0.4 0 0
      vertex 0.2 0.1 0.25
      vertex 0 0.3 0
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex 0 0 0
      vertex 0.2 0.1 0.25
      vertex 0.4 0 0
    endloop
  endfacet
endsolid imported_component_demo
