DEBUT(PAR_LOT='NON');

# ----- Read mesh -----
MAIL0 = LIRE_MAILLAGE(FORMAT='ASTER',
                      UNITE=20);

MAIL = MAIL0;

# ----- Model definition -----
MODELE = AFFE_MODELE(
    MAILLAGE=MAIL,
    AFFE=(
        _F(
            GROUP_MA='AllPipes',
            PHENOMENE='MECANIQUE',
            MODELISATION='TUYAU_3M',
        ),
        _F(
            GROUP_MA='G_TUBE',
            PHENOMENE='MECANIQUE',
            MODELISATION='POU_D_T',
        ),
        _F(
            GROUP_MA='G257349E',
            PHENOMENE='MECANIQUE',
            MODELISATION='DIS_T',
        ),
        _F(
            GROUP_MA='GE72C655',
            PHENOMENE='MECANIQUE',
            MODELISATION='DIS_T',
        ),
        _F(
            GROUP_MA='G79C6D65',
            PHENOMENE='MECANIQUE',
            MODELISATION='DIS_T',
        ),
    ),
);

# ----- Material definitions -----
MAT_STEEL = DEFI_MATERIAU(
    ELAS=_F(
        E=2.100000E+11,
        NU=3.000000E-01,
        RHO=7.850000E+03,
        ALPHA=1.200000E-05,
    ),
);

CM0 = DEFI_MATERIAU(DIS_CONTACT=_F(RIGI_NOR=10000000000.0,RIGI_TAN=100000000.0,COULOMB=0.3,DIST_1=1.0))
CM1 = DEFI_MATERIAU(DIS_CONTACT=_F(RIGI_NOR=10000000000.0,RIGI_TAN=100000000.0,COULOMB=0.3,DIST_1=1.0))
CM2 = DEFI_MATERIAU(DIS_CONTACT=_F(RIGI_NOR=10000000000.0,RIGI_TAN=100000000.0,COULOMB=0.0,DIST_1=1.0))
# ----- Material assignment -----
CHMAT = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(
        _F(
            GROUP_MA='G5AF7883',
            MATER=MAT_STEEL,
        ),
_F(GROUP_MA='G257349E',MATER=CM0),
_F(GROUP_MA='GE72C655',MATER=CM1),
_F(GROUP_MA='G79C6D65',MATER=CM2),
    ),
);

# ----- Cross-section properties -----
CARA = AFFE_CARA_ELEM(
    MODELE=MODELE,
    POUTRE=(
        _F(
            GROUP_MA='GF0AB739',
            SECTION='CERCLE',
            CARA=('R', 'EP'),
            VALE=(5.71500000E-02, 6.02000000E-03),
        ),
        _F(
            GROUP_MA='G6167DC1',
            SECTION='GENERALE',
            CARA=('A', 'IY', 'IZ', 'AY', 'AZ', 'EY', 'EZ', 'JX', 'JG', 'IYR2', 'IZR2', 'RY', 'RZ', 'RT'),
            VALE=(2.00949294E-03, 6.83160340E-07, 8.69467166E-06, 2.58673000E+00, 1.79520300E+00, -1.30000000E-08, -2.00000000E-08, 3.49110397E-08, 3.88907881E-03, 3.17100000E-15, 2.79300000E-15, 8.00000000E-02, 4.10000000E-02, 1.05105490E-02),
        ),
        _F(
            GROUP_MA='G4549CB0',
            SECTION='GENERALE',
            CARA=('A', 'IY', 'IZ', 'AY', 'AZ', 'EY', 'EZ', 'JX', 'JG', 'IYR2', 'IZR2', 'RY', 'RZ', 'RT'),
            VALE=(1.03256912E-03, 1.59193185E-07, 1.71055336E-06, 2.59454200E+00, 1.74649000E+00, -1.80000000E-08, -3.00000000E-09, 1.13956560E-08, 3.42152416E-04, -4.89100000E-15, -4.69600000E-15, 5.00000000E-02, 2.75000000E-02, 8.15206800E-03),
        ),
        _F(
            GROUP_MA='GE87720F',
            SECTION='GENERALE',
            CARA=('A', 'IY', 'IZ', 'AY', 'AZ', 'EY', 'EZ', 'JX', 'JG', 'IYR2', 'IZR2', 'RY', 'RZ', 'RT'),
            VALE=(1.64292474E-03, 4.49187339E-07, 5.41342551E-06, 2.59346000E+00, 1.79631100E+00, 4.20000000E-08, -1.20000000E-08, 2.37319426E-08, 1.95077060E-03, 4.74300000E-15, 3.53900000E-15, 7.00000000E-02, 3.65000000E-02, 9.37024700E-03),
        ),
    ),
    DISCRET=(
_F(GROUP_MA='G257349E',REPERE='LOCAL',CARA='K_T_D_L',VALE=(0.,0.,0.)),
_F(GROUP_MA='GE72C655',REPERE='LOCAL',CARA='K_T_D_L',VALE=(0.,0.,0.)),
_F(GROUP_MA='G79C6D65',REPERE='LOCAL',CARA='K_T_D_L',VALE=(0.,0.,0.)),
    ),
    ORIENTATION=(
_F(GROUP_MA='G257349E',CARA='VECT_Y',VALE=(1.0, 0.0, 0.0)),
_F(GROUP_MA='GE72C655',CARA='VECT_Y',VALE=(1.0, 0.0, 0.0)),
_F(GROUP_MA='G79C6D65',CARA='VECT_Y',VALE=(1.0, 0.0, 0.0)),
        _F(
            GROUP_NO='G06D7539',
            CARA='GENE_TUYAU',
            VALE=(0.00000000E+00, 0.00000000E+00, 1.00000000E+00),
        ),
        _F(
            GROUP_MA='GA32F018',
            CARA='ANGL_VRIL',
            VALE=0.0000,
        ),
        _F(
            GROUP_MA='G8EF347B',
            CARA='ANGL_VRIL',
            VALE=0.0000,
        ),
        _F(
            GROUP_MA='GED6E2B5',
            CARA='ANGL_VRIL',
            VALE=0.0000,
        ),
        _F(
            GROUP_MA='GB37CD11',
            CARA='ANGL_VRIL',
            VALE=0.0000,
        ),
        _F(
            GROUP_MA='G0406E88',
            CARA='ANGL_VRIL',
            VALE=0.0000,
        ),
        _F(
            GROUP_MA='G6FBF954',
            CARA='ANGL_VRIL',
            VALE=0.0000,
        ),
        _F(
            GROUP_MA='G68CA6B3',
            CARA='ANGL_VRIL',
            VALE=0.0000,
        ),
        _F(
            GROUP_MA='G3064D5F',
            CARA='ANGL_VRIL',
            VALE=0.0000,
        ),
        _F(
            GROUP_MA='GBA6CD9B',
            CARA='ANGL_VRIL',
            VALE=0.0000,
        ),
        _F(
            GROUP_MA='G153C40D',
            CARA='ANGL_VRIL',
            VALE=0.0000,
        ),
    ),
);

# ----- Boundary conditions -----
BC_0 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N0',
        BLOCAGE=('DEPLACEMENT', 'ROTATION'),
    ),
);

BC_1 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N1',
        BLOCAGE=('DEPLACEMENT', 'ROTATION'),
    ),
);

BC_2 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N2',
        BLOCAGE=('DEPLACEMENT', 'ROTATION'),
    ),
);

BC_3 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N3',
        BLOCAGE=('DEPLACEMENT', 'ROTATION'),
    ),
);

BC_4 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N10',
        BLOCAGE=('DEPLACEMENT', 'ROTATION'),
        WO=0.0,
    ),
);

BC_5 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N11',
        DY=0.0,
        WO=0.0,
    ),
);

BC_6 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N12',
        WO=0.0,
    ),
);

BC_7 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N13',
        WO=0.0,
    ),
);

BC_8 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N14',
        WO=0.0,
    ),
);

GROUND0 = AFFE_CHAR_MECA(MODELE=MODELE, LIAISON_DDL=(_F(GROUP_NO=('GROUND_6','GN_N8'),DDL=('DX','DX'),COEF_MULT=(1.,-1.),COEF_IMPO=0.),_F(GROUP_NO=('GROUND_6','GN_N8'),DDL=('DY','DY'),COEF_MULT=(1.,-1.),COEF_IMPO=0.),_F(GROUP_NO=('GROUND_6','GN_N8'),DDL=('DZ','DZ'),COEF_MULT=(1.,-1.),COEF_IMPO=0.)))
GROUND1 = AFFE_CHAR_MECA(MODELE=MODELE, LIAISON_DDL=(_F(GROUP_NO=('GROUND_7','GN_N9'),DDL=('DX','DX'),COEF_MULT=(1.,-1.),COEF_IMPO=0.),_F(GROUP_NO=('GROUND_7','GN_N9'),DDL=('DY','DY'),COEF_MULT=(1.,-1.),COEF_IMPO=0.),_F(GROUP_NO=('GROUND_7','GN_N9'),DDL=('DZ','DZ'),COEF_MULT=(1.,-1.),COEF_IMPO=0.)))
GROUND2 = AFFE_CHAR_MECA(MODELE=MODELE, DDL_IMPO=_F(GROUP_NO='GROUND_8',DX=0.,DY=0.,DZ=0.))
# ----- Internal pressure -----
PRESSURE = AFFE_CHAR_MECA(
    MODELE=MODELE,
    FORCE_TUYAU=_F(
        GROUP_MA='AllPipes',
        PRES=1.500000E+06,
    ),
);

# ----- Line loads on pipes and beams -----
LINELOAD = AFFE_CHAR_MECA(
    MODELE=MODELE,
    FORCE_POUTRE=(
        _F(
            GROUP_MA=('G865AF37', 'G8DCD4C6', 'GF75806A', 'G5E41366',),
            FX=0.000000E+00,
            FY=0.000000E+00,
            FZ=-3.500000E+02,
        ),
    ),
);

# ----- Thermal expansion -----
TEMP_REF_FIELD = CREA_CHAMP(
    TYPE_CHAM='NOEU_TEMP_R',
    OPERATION='AFFE',
    MAILLAGE=MAIL,
    AFFE=_F(
        TOUT='OUI',
        NOM_CMP='TEMP',
        VALE=2.000000E+01,
    ),
);

TEMP_HOT_FIELD = CREA_CHAMP(
    TYPE_CHAM='NOEU_TEMP_R',
    OPERATION='AFFE',
    MAILLAGE=MAIL,
    AFFE=_F(
        TOUT='OUI',
        NOM_CMP='TEMP',
        VALE=1.800000E+02,
    ),
);

TEMP_EVOL = CREA_RESU(
    OPERATION='AFFE',
    TYPE_RESU='EVOL_THER',
    NOM_CHAM='TEMP',
    AFFE=(
        _F(CHAM_GD=TEMP_REF_FIELD, INST=0.0),
        _F(CHAM_GD=TEMP_HOT_FIELD, INST=1.0),
    ),
);

CHMAT = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(
        _F(
            GROUP_MA='G5AF7883',
            MATER=MAT_STEEL,
        ),
_F(GROUP_MA='G257349E',MATER=CM0),
_F(GROUP_MA='GE72C655',MATER=CM1),
_F(GROUP_MA='G79C6D65',MATER=CM2),
    ),
    AFFE_VARC=_F(
        GROUP_MA=('AllPipes', 'G_TUBE'),
        NOM_VARC='TEMP',
        EVOL=TEMP_EVOL,
        NOM_CHAM='TEMP',
        VALE_REF=2.000000E+01,
    ),
);

# ----- Solve -----
lst_inst = DEFI_LIST_REEL(DEBUT=0.0, INTERVALLE=_F(JUSQU_A=1.0, NOMBRE=10));
times = DEFI_LIST_INST(DEFI_LIST=_F(LIST_INST=lst_inst));

RESU = STAT_NON_LINE(
    MODELE=MODELE,
    CHAM_MATER=CHMAT,
    CARA_ELEM=CARA,
    EXCIT=(
        _F(CHARGE=BC_0),
        _F(CHARGE=BC_1),
        _F(CHARGE=BC_2),
        _F(CHARGE=BC_3),
        _F(CHARGE=BC_4),
        _F(CHARGE=BC_5),
        _F(CHARGE=BC_6),
        _F(CHARGE=BC_7),
        _F(CHARGE=BC_8),
        _F(CHARGE=GROUND0),
        _F(CHARGE=GROUND1),
        _F(CHARGE=GROUND2),
        _F(CHARGE=PRESSURE),
        _F(CHARGE=LINELOAD),
    ),
    COMPORTEMENT=(
        _F(
            GROUP_MA=('AllPipes', 'G_TUBE',),
            RELATION='ELAS',
        ),
        _F(GROUP_MA='G257349E', RELATION='DIS_CHOC', RESI_INTE=1e-9),
        _F(GROUP_MA='GE72C655', RELATION='DIS_CHOC', RESI_INTE=1e-9),
        _F(GROUP_MA='G79C6D65', RELATION='DIS_CHOC', RESI_INTE=1e-9),
    ),
    INCREMENT=_F(
        LIST_INST=times,
    ),
    CONVERGENCE=_F(RESI_GLOB_RELA=1e-8, ITER_GLOB_MAXI=50),
    METHODE='NEWTON',
);

# ----- Derived fields -----
RESU = CALC_CHAMP(
    reuse=RESU,
    RESULTAT=RESU,
    CONTRAINTE=('EFGE_ELNO', 'SIEF_ELNO'),
    CRITERES=('SIEQ_ELGA', 'SIEQ_ELNO'),
    FORCE='REAC_NODA',
);

# ----- Write MED results file -----
IMPR_RESU(
    FORMAT='MED',
    UNITE=80,
    RESU=_F(
        RESULTAT=RESU,
        INST=1.0,
        CARA_ELEM=CARA,
        NOM_CHAM=('DEPL', 'SIEQ_ELGA', 'SIEQ_ELNO', 'EFGE_ELNO', 'REAC_NODA'),
    ),
);

# ----- Text table for EFGE_ELNO -----
TAB_EFFO = CREA_TABLE(
    RESU=_F(
        RESULTAT=RESU,
        NOM_CHAM='EFGE_ELNO',
        TOUT='OUI',
        NOM_CMP=('N', 'VY', 'VZ', 'MT', 'MFY', 'MFZ'),
        INST=1.0,
    ),
);

IMPR_TABLE(
    TABLE=TAB_EFFO,
    UNITE=38,
    FORMAT='TABLEAU',
    FORMAT_R='1PE24.16',
    SEPARATEUR=',',
);

# ----- Text table for DEPL -----
TAB_DEPL = CREA_TABLE(
    RESU=_F(
        RESULTAT=RESU,
        NOM_CHAM='DEPL',
        TOUT='OUI',
        NOM_CMP=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'),
        INST=1.0,
    ),
);

IMPR_TABLE(
    TABLE=TAB_DEPL,
    UNITE=39,
    FORMAT='TABLEAU',
    FORMAT_R='1PE24.16',
    SEPARATEUR=',',
);

# ----- Text table for REAC_NODA -----
TAB_REAC = CREA_TABLE(
    RESU=_F(
        RESULTAT=RESU,
        NOM_CHAM='REAC_NODA',
        TOUT='OUI',
        NOM_CMP=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'),
        INST=1.0,
    ),
);

IMPR_TABLE(
    TABLE=TAB_REAC,
    UNITE=40,
    FORMAT='TABLEAU',
    FORMAT_R='1PE24.16',
    SEPARATEUR=',',
);

# ----- Text table for SIEQ_ELNO -----
TAB_SIEQ = CREA_TABLE(
    RESU=_F(
        RESULTAT=RESU,
        NOM_CHAM='SIEQ_ELNO',
        TOUT='OUI',
        NOM_CMP=('VMIS',),
        INST=1.0,
    ),
);

IMPR_TABLE(
    TABLE=TAB_SIEQ,
    UNITE=41,
    FORMAT='TABLEAU',
    FORMAT_R='1PE24.16',
    SEPARATEUR=',',
);

import json
contact_rows = []
CT = CREA_TABLE(RESU=_F(RESULTAT=RESU,GROUP_MA='G257349E',NOM_CHAM='SIEF_ELGA',TOUT_CMP='OUI',INST=1.0))
forces = CT.EXTR_TABLE().values()
VT = CREA_TABLE(RESU=_F(RESULTAT=RESU,GROUP_MA='G257349E',NOM_CHAM='VARI_ELGA',TOUT_CMP='OUI',INST=1.0))
variables = VT.EXTR_TABLE().values()
if not all(f'V{i}' in variables for i in range(1,11)): raise RuntimeError('Native friction requires the qualified ten-variable DIS_CHOC layout.')
iv = {float(t): i for i,t in enumerate(variables["INST"]) if variables["POINT"][i] == 1}
for i,t in enumerate(forces["INST"]):
    if forces["POINT"][i] != 1: continue
    j = iv[float(t)]
    contact_rows.append(dict(support_id='support_6',instant=float(t),N=forces["N"][i],VY=forces["VY"][i],VZ=forces["VZ"][i],slip_y=variables["V5"][j],slip_z=variables["V6"][j],status=variables["V4"][j]))
CT = CREA_TABLE(RESU=_F(RESULTAT=RESU,GROUP_MA='GE72C655',NOM_CHAM='SIEF_ELGA',TOUT_CMP='OUI',INST=1.0))
forces = CT.EXTR_TABLE().values()
VT = CREA_TABLE(RESU=_F(RESULTAT=RESU,GROUP_MA='GE72C655',NOM_CHAM='VARI_ELGA',TOUT_CMP='OUI',INST=1.0))
variables = VT.EXTR_TABLE().values()
if not all(f'V{i}' in variables for i in range(1,11)): raise RuntimeError('Native friction requires the qualified ten-variable DIS_CHOC layout.')
iv = {float(t): i for i,t in enumerate(variables["INST"]) if variables["POINT"][i] == 1}
for i,t in enumerate(forces["INST"]):
    if forces["POINT"][i] != 1: continue
    j = iv[float(t)]
    contact_rows.append(dict(support_id='support_7',instant=float(t),N=forces["N"][i],VY=forces["VY"][i],VZ=forces["VZ"][i],slip_y=variables["V5"][j],slip_z=variables["V6"][j],status=variables["V4"][j]))
CT = CREA_TABLE(RESU=_F(RESULTAT=RESU,GROUP_MA='G79C6D65',NOM_CHAM='SIEF_ELGA',TOUT_CMP='OUI',INST=1.0))
forces = CT.EXTR_TABLE().values()
VT = CREA_TABLE(RESU=_F(RESULTAT=RESU,GROUP_MA='G79C6D65',NOM_CHAM='VARI_ELGA',TOUT_CMP='OUI',INST=1.0))
variables = VT.EXTR_TABLE().values()
if not all(f'V{i}' in variables for i in range(1,11)): raise RuntimeError('Native friction requires the qualified ten-variable DIS_CHOC layout.')
iv = {float(t): i for i,t in enumerate(variables["INST"]) if variables["POINT"][i] == 1}
for i,t in enumerate(forces["INST"]):
    if forces["POINT"][i] != 1: continue
    j = iv[float(t)]
    contact_rows.append(dict(support_id='support_8',instant=float(t),N=forces["N"][i],VY=forces["VY"][i],VZ=forces["VZ"][i],slip_y=variables["V5"][j],slip_z=variables["V6"][j],status=variables["V4"][j]))
with open('fort.42','w') as stream: json.dump(contact_rows,stream,allow_nan=False)
FIN();