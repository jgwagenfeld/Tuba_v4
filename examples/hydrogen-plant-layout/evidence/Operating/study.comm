# ----- Thermal expansion -----
TEMP_REF_FIELD = CREA_CHAMP(
    TYPE_CHAM='NOEU_TEMP_R',
    OPERATION='AFFE',
    MAILLAGE=MAIL,
    AFFE=_F(
        TOUT='OUI',
        NOM_CMP='TEMP',
        VALE=2.000000E+01,
    ),
);

