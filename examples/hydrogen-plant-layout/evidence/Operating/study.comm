    TYPE_CHAM='NOEU_TEMP_R',
    OPERATION='AFFE',
    MAILLAGE=MAIL,
    AFFE=_F(
        TOUT='OUI',
        NOM_CMP='TEMP',
        VALE=6.500000E+01,
    ),
);

TEMP_EVOL = CREA_RESU(
    OPERATION='AFFE',
    TYPE_RESU='EVOL_THER',
    NOM_CHAM='TEMP',
    AFFE=(
        _F(CHAM_GD=TEMP_REF_FIELD, INST=0.0),
        _F(CHAM_GD=TEMP_HOT_FIELD, INST=1.0),
    ),
);

