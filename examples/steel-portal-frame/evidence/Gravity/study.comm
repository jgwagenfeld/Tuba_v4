    ELAS=_F(
        E=2.100000E+11,
        NU=3.000000E-01,
        RHO=7.850000E+03,
        ALPHA=1.200000E-05,
    ),
);

# ----- Material assignment -----
CHMAT = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(
        _F(
            TOUT='OUI',
            MATER=MAT_S355,
        ),
    ),
);

