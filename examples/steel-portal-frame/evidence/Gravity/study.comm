    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N142',
        BLOCAGE=('DEPLACEMENT', 'ROTATION'),
    ),
);

BC_9 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N146',
        BLOCAGE=('DEPLACEMENT', 'ROTATION'),
    ),
);

BC_10 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N172',
        BLOCAGE=('DEPLACEMENT', 'ROTATION'),
    ),
);

BC_11 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N176',
        BLOCAGE=('DEPLACEMENT', 'ROTATION'),
    ),
);

BC_12 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N202',
        BLOCAGE=('DEPLACEMENT', 'ROTATION'),
    ),
);

BC_13 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N206',
        BLOCAGE=('DEPLACEMENT', 'ROTATION'),
    ),
);

# ----- Gravity -----
GRAVITY = AFFE_CHAR_MECA(
    MODELE=MODELE,
    PESANTEUR=_F(
        GRAVITE=9.81,
        DIRECTION=(0.0, 0.0, -1.0),
    ),
);

# ----- Solve -----
RESU = MECA_STATIQUE(
    MODELE=MODELE,
    CHAM_MATER=CHMAT,
    CARA_ELEM=CARA,
    EXCIT=(
        _F(CHARGE=BC_0),
        _F(CHARGE=BC_1),
        _F(CHARGE=BC_2),
        _F(CHARGE=BC_3),
        _F(CHARGE=BC_4),
        _F(CHARGE=BC_5),
        _F(CHARGE=BC_6),
        _F(CHARGE=BC_7),
        _F(CHARGE=BC_8),
        _F(CHARGE=BC_9),
        _F(CHARGE=BC_10),
        _F(CHARGE=BC_11),
        _F(CHARGE=BC_12),
        _F(CHARGE=BC_13),
        _F(CHARGE=GRAVITY),
    ),
);

# ----- Derived fields -----
RESU = CALC_CHAMP(
    reuse=RESU,
    RESULTAT=RESU,
    CONTRAINTE=('EFGE_ELNO', 'SIEF_ELNO'),
    FORCE='REAC_NODA',
);

# ----- Write MED results file -----
IMPR_RESU(
    FORMAT='MED',
    UNITE=80,
    RESU=_F(
        RESULTAT=RESU,
        NOM_CHAM=('DEPL', 'EFGE_ELNO', 'REAC_NODA'),
    ),
);

# ----- Text table for EFGE_ELNO -----
TAB_EFFO = CREA_TABLE(
    RESU=_F(
        RESULTAT=RESU,
        NOM_CHAM='EFGE_ELNO',
        TOUT='OUI',
        NOM_CMP=('N', 'VY', 'VZ', 'MT', 'MFY', 'MFZ'),
    ),
);

IMPR_TABLE(
    TABLE=TAB_EFFO,
    UNITE=38,
    FORMAT='TABLEAU',
    FORMAT_R='1PE24.16',
    SEPARATEUR=',',
);

# ----- Text table for DEPL -----
TAB_DEPL = CREA_TABLE(
    RESU=_F(
        RESULTAT=RESU,
        NOM_CHAM='DEPL',
        TOUT='OUI',
        NOM_CMP=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'),
    ),
);

IMPR_TABLE(
    TABLE=TAB_DEPL,
    UNITE=39,
    FORMAT='TABLEAU',
    FORMAT_R='1PE24.16',
    SEPARATEUR=',',
);

# ----- Text table for REAC_NODA -----
TAB_REAC = CREA_TABLE(
    RESU=_F(
        RESULTAT=RESU,
        NOM_CHAM='REAC_NODA',
        TOUT='OUI',
        NOM_CMP=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'),
    ),
);

IMPR_TABLE(
    TABLE=TAB_REAC,
    UNITE=40,
    FORMAT='TABLEAU',
    FORMAT_R='1PE24.16',
    SEPARATEUR=',',
);

# ----- Linear buckling eigenvalue analysis on this load case's prestress -----
PREC = CREA_CHAMP(
    RESULTAT=RESU,
    NOM_CHAM='SIEF_ELGA',
    NUME_ORDRE=1,
    OPERATION='EXTR',
    TYPE_CHAM='ELGA_SIEF_R',
);

# Elastic stiffness.
MELR = CALC_MATR_ELEM(
    MODELE=MODELE,
    CARA_ELEM=CARA,
    CHAM_MATER=CHMAT,
    OPTION='RIGI_MECA',
    CHARGE=(BC_0, BC_1, BC_2, BC_3, BC_4, BC_5, BC_6, BC_7, BC_8, BC_9, BC_10, BC_11, BC_12, BC_13,),
);

# Geometric stiffness: the only thing that makes a structure able to buckle.
MERG = CALC_MATR_ELEM(
    MODELE=MODELE,
    CARA_ELEM=CARA,
    OPTION='RIGI_GEOM',
    SIEF_ELGA=PREC,
);

NUM_DDL = NUME_DDL(MATR_RIGI=MELR);
K_MECA = ASSE_MATRICE(MATR_ELEM=MELR, NUME_DDL=NUM_DDL);
K_GEOM = ASSE_MATRICE(MATR_ELEM=MERG, NUME_DDL=NUM_DDL);

MD_FLANB = CALC_MODES(
    MATR_RIGI=K_MECA,
    TYPE_RESU='MODE_FLAMB',
    MATR_RIGI_GEOM=K_GEOM,
    CALC_CHAR_CRIT=_F(NMAX_CHAR_CRIT=8),
    VERI_MODE=_F(STOP_ERREUR="NON"),
    SOLVEUR_MODAL=_F(
        MODE_RIGIDE='NON',
        METHODE='TRI_DIAG',
        COEF_DIM_ESPACE=12,
    ),
);

# Mode shapes, in the same column layout as a static DEPL table so the
# standard displacement reader can consume them.
TAB_FLANB = CREA_TABLE(
    RESU=_F(
        RESULTAT=MD_FLANB,
        NOM_CHAM='DEPL',
        TOUT='OUI',
        TOUT_CMP='OUI',
    ),
);

IMPR_TABLE(
    TABLE=TAB_FLANB,
    UNITE=43,
    FORMAT='TABLEAU',
    FORMAT_R='1PE24.16',
    SEPARATEUR=',',
);

# Critical load factors. Code_Aster reports CHAR_CRIT negative; the sign is a
# convention of the eigenproblem, so the magnitude is the load factor and the
# raw value is kept beside it for traceability.
import json
_flamb_params = MD_FLANB.getParameters()
_flamb_raw = _flamb_params.get('CHAR_CRIT', []) or []
buckling_rows = [
    {
        'mode': int(_mode),
        'critical_factor': abs(float(_value)),
        'raw_eigenvalue': float(_value),
    }
    for _mode, _value in enumerate(_flamb_raw, start=1)
]
with open('fort.44', 'w') as _stream:
    json.dump({'modes': buckling_rows}, _stream, allow_nan=False)

FIN();