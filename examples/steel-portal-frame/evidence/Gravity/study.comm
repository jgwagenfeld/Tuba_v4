# ----- Boundary conditions -----
BC_0 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N22',
        BLOCAGE=('DEPLACEMENT', 'ROTATION'),
    ),
);

BC_1 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N26',
        BLOCAGE=('DEPLACEMENT', 'ROTATION'),
    ),
);

BC_2 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N52',
        BLOCAGE=('DEPLACEMENT', 'ROTATION'),
    ),
);

BC_3 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N56',
        BLOCAGE=('DEPLACEMENT', 'ROTATION'),
    ),
);

