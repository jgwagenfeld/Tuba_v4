    DDL_IMPO=_F(
        GROUP_NO='GN_N8',
        WO=0.0,
    ),
);

GROUND0 = AFFE_CHAR_MECA(MODELE=MODELE, LIAISON_DDL=(_F(GROUP_NO=('GC77C21F','GN_N33'),DDL=('DX','DX'),COEF_MULT=(1.,-1.),COEF_IMPO=0.),_F(GROUP_NO=('GC77C21F','GN_N33'),DDL=('DY','DY'),COEF_MULT=(1.,-1.),COEF_IMPO=0.),_F(GROUP_NO=('GC77C21F','GN_N33'),DDL=('DZ','DZ'),COEF_MULT=(1.,-1.),COEF_IMPO=0.)))
GROUND1 = AFFE_CHAR_MECA(MODELE=MODELE, LIAISON_DDL=(_F(GROUP_NO=('GC2F3B77','GN_N34'),DDL=('DX','DX'),COEF_MULT=(1.,-1.),COEF_IMPO=0.),_F(GROUP_NO=('GC2F3B77','GN_N34'),DDL=('DY','DY'),COEF_MULT=(1.,-1.),COEF_IMPO=0.),_F(GROUP_NO=('GC2F3B77','GN_N34'),DDL=('DZ','DZ'),COEF_MULT=(1.,-1.),COEF_IMPO=0.)))
GROUND2 = AFFE_CHAR_MECA(MODELE=MODELE, LIAISON_DDL=(_F(GROUP_NO=('GD3F8976','GN_N35'),DDL=('DX','DX'),COEF_MULT=(1.,-1.),COEF_IMPO=0.),_F(GROUP_NO=('GD3F8976','GN_N35'),DDL=('DY','DY'),COEF_MULT=(1.,-1.),COEF_IMPO=0.),_F(GROUP_NO=('GD3F8976','GN_N35'),DDL=('DZ','DZ'),COEF_MULT=(1.,-1.),COEF_IMPO=0.)))
GROUND3 = AFFE_CHAR_MECA(MODELE=MODELE, LIAISON_DDL=(_F(GROUP_NO=('GEE3684B','GN_N36'),DDL=('DX','DX'),COEF_MULT=(1.,-1.),COEF_IMPO=0.),_F(GROUP_NO=('GEE3684B','GN_N36'),DDL=('DY','DY'),COEF_MULT=(1.,-1.),COEF_IMPO=0.),_F(GROUP_NO=('GEE3684B','GN_N36'),DDL=('DZ','DZ'),COEF_MULT=(1.,-1.),COEF_IMPO=0.)))
GROUND4 = AFFE_CHAR_MECA(MODELE=MODELE, LIAISON_DDL=(_F(GROUP_NO=('G7AE05B8','GN_N37'),DDL=('DX','DX'),COEF_MULT=(1.,-1.),COEF_IMPO=0.),_F(GROUP_NO=('G7AE05B8','GN_N37'),DDL=('DY','DY'),COEF_MULT=(1.,-1.),COEF_IMPO=0.),_F(GROUP_NO=('G7AE05B8','GN_N37'),DDL=('DZ','DZ'),COEF_MULT=(1.,-1.),COEF_IMPO=0.)))
# ----- Gravity -----
GRAVITY = AFFE_CHAR_MECA(
    MODELE=MODELE,
    PESANTEUR=_F(
        GRAVITE=9.81,
        DIRECTION=(0.0, 0.0, -1.0),
    ),
);

# ----- Internal pressure -----
PRESSURE = AFFE_CHAR_MECA(
    MODELE=MODELE,
    FORCE_TUYAU=_F(
        GROUP_MA='AllPipes',
        PRES=2.000000E+06,
    ),
);

# ----- Thermal expansion -----
TEMP_REF_FIELD = CREA_CHAMP(
    TYPE_CHAM='NOEU_TEMP_R',
    OPERATION='AFFE',
    MAILLAGE=MAIL,
    AFFE=_F(
        TOUT='OUI',
        NOM_CMP='TEMP',
        VALE=2.000000E+01,
    ),
);

TEMP_HOT_FIELD = CREA_CHAMP(
    TYPE_CHAM='NOEU_TEMP_R',
    OPERATION='AFFE',
    MAILLAGE=MAIL,
    AFFE=_F(
        TOUT='OUI',
        NOM_CMP='TEMP',
        VALE=1.500000E+02,
    ),
);

TEMP_EVOL = CREA_RESU(
    OPERATION='AFFE',
    TYPE_RESU='EVOL_THER',
    NOM_CHAM='TEMP',
    AFFE=(
        _F(CHAM_GD=TEMP_REF_FIELD, INST=0.0),
        _F(CHAM_GD=TEMP_HOT_FIELD, INST=1.0),
    ),
);

CHMAT = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(
        _F(
            GROUP_MA='G67F931E',
            MATER=MAT_P265GH,
        ),
        _F(
            GROUP_MA='G5AF7883',
            MATER=MAT_STEEL,
        ),
_F(GROUP_MA='G9BD02A1',MATER=CM0),
_F(GROUP_MA='G157A0E3',MATER=CM1),
_F(GROUP_MA='GBB23ACA',MATER=CM2),
_F(GROUP_MA='G74A7F8A',MATER=CM3),
_F(GROUP_MA='G0FA7226',MATER=CM4),
    ),
    AFFE_VARC=_F(
        GROUP_MA=('AllPipes', 'G_TUBE'),
        NOM_VARC='TEMP',
        EVOL=TEMP_EVOL,
        NOM_CHAM='TEMP',
        VALE_REF=2.000000E+01,
    ),
);

# ----- Solve -----
lst_inst = DEFI_LIST_REEL(DEBUT=0.0, INTERVALLE=_F(JUSQU_A=1.0, NOMBRE=10));
times = DEFI_LIST_INST(DEFI_LIST=_F(LIST_INST=lst_inst));

RESU = STAT_NON_LINE(
    MODELE=MODELE,
    CHAM_MATER=CHMAT,
    CARA_ELEM=CARA,
    EXCIT=(
        _F(CHARGE=BC_0),
        _F(CHARGE=BC_1),
        _F(CHARGE=BC_2),
        _F(CHARGE=BC_3),
        _F(CHARGE=BC_4),
        _F(CHARGE=BC_5),
        _F(CHARGE=BC_6),
        _F(CHARGE=BC_7),
        _F(CHARGE=BC_8),
        _F(CHARGE=BC_9),
        _F(CHARGE=BC_10),
        _F(CHARGE=BC_11),
        _F(CHARGE=BC_12),
        _F(CHARGE=BC_13),
        _F(CHARGE=BC_14),
        _F(CHARGE=BC_15),
        _F(CHARGE=BC_16),
        _F(CHARGE=GROUND0),
        _F(CHARGE=GROUND1),
        _F(CHARGE=GROUND2),
        _F(CHARGE=GROUND3),
        _F(CHARGE=GROUND4),
        _F(CHARGE=GRAVITY),
        _F(CHARGE=PRESSURE),
    ),
    COMPORTEMENT=(
        _F(
            GROUP_MA=('AllPipes', 'G_TUBE',),
            RELATION='ELAS',
        ),
        _F(GROUP_MA='G9BD02A1', RELATION='DIS_CHOC', RESI_INTE=1e-9),
        _F(GROUP_MA='G157A0E3', RELATION='DIS_CHOC', RESI_INTE=1e-9),
        _F(GROUP_MA='GBB23ACA', RELATION='DIS_CHOC', RESI_INTE=1e-9),
        _F(GROUP_MA='G74A7F8A', RELATION='DIS_CHOC', RESI_INTE=1e-9),
        _F(GROUP_MA='G0FA7226', RELATION='DIS_CHOC', RESI_INTE=1e-9),
    ),
    INCREMENT=_F(
        LIST_INST=times,
    ),
    CONVERGENCE=_F(RESI_GLOB_RELA=1e-8, ITER_GLOB_MAXI=50),
    METHODE='NEWTON',
);

# ----- Derived fields -----
RESU = CALC_CHAMP(
    reuse=RESU,
    RESULTAT=RESU,
    CONTRAINTE=('EFGE_ELNO', 'SIEF_ELNO'),
    CRITERES=('SIEQ_ELGA', 'SIEQ_ELNO'),
    FORCE='REAC_NODA',
);

# ----- Write MED results file -----
IMPR_RESU(
    FORMAT='MED',
    UNITE=80,
    RESU=_F(
        RESULTAT=RESU,
        INST=1.0,
        CARA_ELEM=CARA,
        NOM_CHAM=('DEPL', 'SIEQ_ELGA', 'SIEQ_ELNO', 'EFGE_ELNO', 'REAC_NODA'),
    ),
);

# ----- Text table for EFGE_ELNO -----
TAB_EFFO = CREA_TABLE(
    RESU=_F(
        RESULTAT=RESU,
        NOM_CHAM='EFGE_ELNO',
        TOUT='OUI',
        NOM_CMP=('N', 'VY', 'VZ', 'MT', 'MFY', 'MFZ'),
        INST=1.0,
    ),
);

IMPR_TABLE(
    TABLE=TAB_EFFO,
    UNITE=38,
    FORMAT='TABLEAU',
    FORMAT_R='1PE24.16',
    SEPARATEUR=',',
);

# ----- Text table for DEPL -----
TAB_DEPL = CREA_TABLE(
    RESU=_F(
        RESULTAT=RESU,
        NOM_CHAM='DEPL',
        TOUT='OUI',
        NOM_CMP=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'),
        INST=1.0,
    ),
);

