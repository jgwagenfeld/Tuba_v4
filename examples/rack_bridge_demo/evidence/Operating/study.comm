        RESULTAT=RESU,
        NOM_CHAM='REAC_NODA',
        TOUT='OUI',
        NOM_CMP=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'),
        INST=1.0,
    ),
);

IMPR_TABLE(
    TABLE=TAB_REAC,
    UNITE=40,
    FORMAT='TABLEAU',
    FORMAT_R='1PE24.16',
    SEPARATEUR=',',
);

# ----- Text table for SIEQ_ELNO -----
TAB_SIEQ = CREA_TABLE(
    RESU=_F(
