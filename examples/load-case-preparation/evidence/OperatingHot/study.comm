            GROUP_NO='G06D7539',
            CARA='GENE_TUYAU',
            VALE=(1.00000000E+00, 1.00000000E+00, 1.00000000E+00),
        ),
    ),
);

# ----- Boundary conditions -----
BC_0 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N0',
        BLOCAGE=('DEPLACEMENT', 'ROTATION'),
        WO=0.0,
    ),
);

BC_1 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N5',
        BLOCAGE=('DEPLACEMENT', 'ROTATION'),
        WO=0.0,
