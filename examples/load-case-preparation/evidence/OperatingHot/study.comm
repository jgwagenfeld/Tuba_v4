# ----- Gravity -----
GRAVITY = AFFE_CHAR_MECA(
    MODELE=MODELE,
    PESANTEUR=_F(
        GRAVITE=9.81,
        DIRECTION=(0.0, 0.0, -1.0),
    ),
);

# ----- Internal pressure -----
PRESSURE = AFFE_CHAR_MECA(
    MODELE=MODELE,
    FORCE_TUYAU=(
