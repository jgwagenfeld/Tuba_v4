DEBUT(PAR_LOT='NON');

# ----- Read mesh -----
MAIL0 = LIRE_MAILLAGE(FORMAT='ASTER',
                      UNITE=20);

MAIL = MAIL0;

# ----- Model definition -----
MODELE = AFFE_MODELE(
    MAILLAGE=MAIL,
    AFFE=(
        _F(
            GROUP_MA='G_TUBE',
            PHENOMENE='MECANIQUE',
            MODELISATION='POU_D_T',
        ),
    ),
);

# ----- Material definitions -----
MAT_STEEL = DEFI_MATERIAU(
    ELAS=_F(
        E=2.000000E+11,
        NU=3.000000E-01,
        RHO=7.850000E+03,
        ALPHA=1.200000E-05,
    ),
);

# ----- Material assignment -----
CHMAT = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(
        _F(
            TOUT='OUI',
            MATER=MAT_STEEL,
        ),
    ),
);

# ----- Cross-section properties -----
CARA = AFFE_CARA_ELEM(
    MODELE=MODELE,
    POUTRE=(
        _F(
            GROUP_MA='G2E2F755',
            SECTION='GENERALE',
            CARA=('A', 'IY', 'IZ', 'AY', 'AZ', 'EY', 'EZ', 'JX', 'JG', 'IYR2', 'IZR2', 'RY', 'RZ', 'RT'),
            VALE=(1.03256912E-03, 1.59193185E-07, 1.71055336E-06, 2.59454200E+00, 1.74649000E+00, -1.80000000E-08, -3.00000000E-09, 1.13956560E-08, 3.42152416E-04, -4.89100000E-15, -4.69600000E-15, 5.00000000E-02, 2.75000000E-02, 8.15206800E-03),
        ),
    ),
    ORIENTATION=(
        _F(
            GROUP_MA='roll0_0',
            CARA='ANGL_VRIL',
            VALE=0.0000,
        ),
        _F(
            GROUP_MA='roll0_1',
            CARA='ANGL_VRIL',
            VALE=0.0000,
        ),
        _F(
            GROUP_MA='roll0_2',
            CARA='ANGL_VRIL',
            VALE=0.0000,
        ),
        _F(
            GROUP_MA='roll0_3',
            CARA='ANGL_VRIL',
            VALE=0.0000,
        ),
        _F(
            GROUP_MA='roll0_4',
            CARA='ANGL_VRIL',
            VALE=0.0000,
        ),
        _F(
            GROUP_MA='roll0_5',
            CARA='ANGL_VRIL',
            VALE=0.0000,
        ),
        _F(
            GROUP_MA='roll0_6',
            CARA='ANGL_VRIL',
            VALE=0.0000,
        ),
        _F(
            GROUP_MA='roll0_7',
            CARA='ANGL_VRIL',
            VALE=0.0000,
        ),
        _F(
            GROUP_MA='roll0_8',
            CARA='ANGL_VRIL',
            VALE=0.0000,
        ),
        _F(
            GROUP_MA='roll0_9',
            CARA='ANGL_VRIL',
            VALE=0.0000,
        ),
        _F(
            GROUP_MA='roll0_10',
            CARA='ANGL_VRIL',
            VALE=0.0000,
        ),
        _F(
            GROUP_MA='roll0_11',
            CARA='ANGL_VRIL',
            VALE=0.0000,
        ),
        _F(
            GROUP_MA='roll45_0',
            CARA='ANGL_VRIL',
            VALE=45.0000,
        ),
        _F(
            GROUP_MA='roll45_1',
            CARA='ANGL_VRIL',
            VALE=45.0000,
        ),
        _F(
            GROUP_MA='roll45_2',
            CARA='ANGL_VRIL',
            VALE=45.0000,
        ),
        _F(
            GROUP_MA='roll45_3',
            CARA='ANGL_VRIL',
            VALE=45.0000,
        ),
        _F(
            GROUP_MA='roll45_4',
            CARA='ANGL_VRIL',
            VALE=45.0000,
        ),
        _F(
            GROUP_MA='roll45_5',
            CARA='ANGL_VRIL',
            VALE=45.0000,
        ),
        _F(
            GROUP_MA='roll45_6',
            CARA='ANGL_VRIL',
            VALE=45.0000,
        ),
        _F(
            GROUP_MA='roll45_7',
            CARA='ANGL_VRIL',
            VALE=45.0000,
        ),
        _F(
            GROUP_MA='roll45_8',
            CARA='ANGL_VRIL',
            VALE=45.0000,
        ),
        _F(
            GROUP_MA='roll45_9',
            CARA='ANGL_VRIL',
            VALE=45.0000,
        ),
        _F(
            GROUP_MA='G03F7A69',
            CARA='ANGL_VRIL',
            VALE=45.0000,
        ),
        _F(
            GROUP_MA='G2066FC7',
            CARA='ANGL_VRIL',
            VALE=45.0000,
        ),
        _F(
            GROUP_MA='roll90_0',
            CARA='ANGL_VRIL',
            VALE=90.0000,
        ),
        _F(
            GROUP_MA='roll90_1',
            CARA='ANGL_VRIL',
            VALE=90.0000,
        ),
        _F(
            GROUP_MA='roll90_2',
            CARA='ANGL_VRIL',
            VALE=90.0000,
        ),
        _F(
            GROUP_MA='roll90_3',
            CARA='ANGL_VRIL',
            VALE=90.0000,
        ),
        _F(
            GROUP_MA='roll90_4',
            CARA='ANGL_VRIL',
            VALE=90.0000,
        ),
        _F(
            GROUP_MA='roll90_5',
            CARA='ANGL_VRIL',
            VALE=90.0000,
        ),
        _F(
