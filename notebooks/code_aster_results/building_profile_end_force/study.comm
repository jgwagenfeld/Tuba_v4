DEBUT(PAR_LOT='NON');

# ----- Read mesh -----
MAIL0 = LIRE_MAILLAGE(FORMAT='ASTER',
                      UNITE=20);

MAIL = MAIL0;

# ----- Model definition -----
MODELE = AFFE_MODELE(
    MAILLAGE=MAIL,
    AFFE=(
        _F(
            GROUP_MA='G_TUBE',
            PHENOMENE='MECANIQUE',
            MODELISATION='POU_D_T',
        ),
    ),
);

# ----- Material definitions -----
MAT_STEEL = DEFI_MATERIAU(
    ELAS=_F(
        E=2.100000E+11,
        NU=3.000000E-01,
        RHO=7.850000E+03,
        ALPHA=0.000000E+00,
    ),
);

# ----- Material assignment -----
CHMAT = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(
        _F(
            TOUT='OUI',
            MATER=MAT_STEEL,
        ),
    ),
);

