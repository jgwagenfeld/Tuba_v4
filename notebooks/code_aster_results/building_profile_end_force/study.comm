# ----- Boundary conditions -----
BC_0 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N0',
        BLOCAGE=('DEPLACEMENT', 'ROTATION'),
    ),
);

BC_1 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N13',
        BLOCAGE=('DEPLACEMENT', 'ROTATION'),
    ),
);

BC_2 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N26',
        BLOCAGE=('DEPLACEMENT', 'ROTATION'),
    ),
);

BC_3 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N39',
        BLOCAGE=('DEPLACEMENT', 'ROTATION'),
    ),
);

# ----- Concentrated nodal forces -----
POINT_FORCE = AFFE_CHAR_MECA(
    MODELE=MODELE,
    FORCE_NODALE=(
        _F(
            GROUP_NO='GN_N12',
            FX=0.00000000E+00,
            FY=0.00000000E+00,
            FZ=-5.00000000E+02,
            MX=0.00000000E+00,
            MY=0.00000000E+00,
            MZ=0.00000000E+00,
        ),
        _F(
            GROUP_NO='GN_N25',
            FX=0.00000000E+00,
            FY=0.00000000E+00,
            FZ=-5.00000000E+02,
            MX=0.00000000E+00,
            MY=0.00000000E+00,
            MZ=0.00000000E+00,
        ),
        _F(
            GROUP_NO='GN_N38',
            FX=0.00000000E+00,
            FY=0.00000000E+00,
            FZ=-5.00000000E+02,
            MX=0.00000000E+00,
            MY=0.00000000E+00,
            MZ=0.00000000E+00,
        ),
        _F(
            GROUP_NO='GN_N51',
            FX=0.00000000E+00,
            FY=0.00000000E+00,
            FZ=-5.00000000E+02,
            MX=0.00000000E+00,
            MY=0.00000000E+00,
            MZ=0.00000000E+00,
        ),
    ),
);

# ----- Solve -----
RESU = MECA_STATIQUE(
    MODELE=MODELE,
    CHAM_MATER=CHMAT,
    CARA_ELEM=CARA,
    EXCIT=(
        _F(CHARGE=BC_0),
        _F(CHARGE=BC_1),
        _F(CHARGE=BC_2),
        _F(CHARGE=BC_3),
        _F(CHARGE=POINT_FORCE),
    ),
);

# ----- Derived fields -----
RESU = CALC_CHAMP(
    reuse=RESU,
    RESULTAT=RESU,
    CONTRAINTE=('EFGE_ELNO', 'SIEF_ELNO'),
    FORCE='FORC_NODA',
);

# ----- Write MED results file -----
IMPR_RESU(
    FORMAT='MED',
    UNITE=80,
    RESU=_F(
        RESULTAT=RESU,
        NOM_CHAM=('DEPL', 'EFGE_ELNO', 'FORC_NODA'),
    ),
);

# ----- Text table for EFGE_ELNO -----
TAB_EFFO = CREA_TABLE(
    RESU=_F(
        RESULTAT=RESU,
        NOM_CHAM='EFGE_ELNO',
        TOUT='OUI',
        NOM_CMP=('N', 'VY', 'VZ', 'MT', 'MFY', 'MFZ'),
    ),
);

IMPR_TABLE(
    TABLE=TAB_EFFO,
    UNITE=38,
    FORMAT='TABLEAU',
    SEPARATEUR=',',
);

# ----- Text table for DEPL -----
TAB_DEPL = CREA_TABLE(
    RESU=_F(
        RESULTAT=RESU,
        NOM_CHAM='DEPL',
        TOUT='OUI',
        NOM_CMP=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'),
    ),
);

IMPR_TABLE(
    TABLE=TAB_DEPL,
    UNITE=39,
    FORMAT='TABLEAU',
    SEPARATEUR=',',
);

# ----- Text table for FORC_NODA -----
TAB_REAC = CREA_TABLE(
    RESU=_F(
        RESULTAT=RESU,
        NOM_CHAM='FORC_NODA',
        TOUT='OUI',
        NOM_CMP=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'),
    ),
);

IMPR_TABLE(
    TABLE=TAB_REAC,
    UNITE=40,
    FORMAT='TABLEAU',
    SEPARATEUR=',',
);

FIN();