DEBUT(PAR_LOT='NON');

# ----- Read mesh -----
MAIL0 = LIRE_MAILLAGE(FORMAT='ASTER',
                      UNITE=20);

MAIL = MAIL0;

# ----- Model definition -----
MODELE = AFFE_MODELE(
    MAILLAGE=MAIL,
    AFFE=(
        _F(
            GROUP_MA='AllPipes',
            PHENOMENE='MECANIQUE',
            MODELISATION='TUYAU_3M',
        ),
    ),
);

# ----- Material definitions -----
MAT_STEEL = DEFI_MATERIAU(
    ELAS=_F(
        E=2.000000E+11,
        NU=3.000000E-01,
        RHO=7.850000E+03,
        ALPHA=1.200000E-05,
    ),
);

# ----- Material assignment -----
CHMAT = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(
        _F(
            TOUT='OUI',
            MATER=MAT_STEEL,
        ),
    ),
);

# ----- Cross-section properties -----
CARA = AFFE_CARA_ELEM(
    MODELE=MODELE,
    POUTRE=(
        _F(
            GROUP_MA='GF0AB739',
            SECTION='CERCLE',
            CARA=('R', 'EP'),
            VALE=(5.71500000E-02, 6.00000000E-03),
        ),
        _F(
            GROUP_MA='G8652C19',
            SECTION='CERCLE',
            CARA=('R', 'EP'),
            VALE=(5.71500000E-02, 6.00000000E-03),
        ),
        _F(
            GROUP_MA='G8652C19',
            SECTION='COUDE',
        ),
    ),
    ORIENTATION=(
        _F(
            GROUP_NO='G06D7539',
            CARA='GENE_TUYAU',
            VALE=(0.0, 0.0, 1.0),
        ),
    ),
);

# ----- Boundary conditions -----
BC_0 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N0',
        BLOCAGE=('DEPLACEMENT', 'ROTATION'),
        WO=0.0,
    ),
);

BC_1 = AFFE_CHAR_MECA(
    MODELE=MODELE,
    DDL_IMPO=_F(
        GROUP_NO='GN_N3',
        BLOCAGE=('DEPLACEMENT', 'ROTATION'),
        WO=0.0,
    ),
);

# ----- Gravity -----
GRAVITY = AFFE_CHAR_MECA(
    MODELE=MODELE,
    PESANTEUR=_F(
        GRAVITE=9.81,
        DIRECTION=(0.0, -1.0, 0.0),
    ),
);

# ----- Internal pressure -----
PRESSURE = AFFE_CHAR_MECA(
    MODELE=MODELE,
    FORCE_TUYAU=_F(
        GROUP_MA='AllPipes',
        PRES=1.500000E+06,
    ),
);

# ----- Thermal expansion -----
T_FUNC = DEFI_CONSTANTE(VALE=1.0);

TEMP_FIELD = CREA_CHAMP(
    TYPE_CHAM='NOEU_TEMP_R',
    OPERATION='AFFE',
    MAILLAGE=MAIL,
    AFFE=_F(
        TOUT='OUI',
        NOM_CMP='TEMP',
        VALE=1.500000E+02,
    ),
);

CHMAT = AFFE_MATERIAU(
    MAILLAGE=MAIL,
    AFFE=(
        _F(
            TOUT='OUI',
            MATER=MAT_STEEL,
        ),
    ),
    AFFE_VARC=_F(
        TOUT='OUI',
        NOM_VARC='TEMP',
        CHAM_GD=TEMP_FIELD,
        VALE_REF=2.000000E+01,
    ),
);

# ----- Solve -----
RESU = MECA_STATIQUE(
    MODELE=MODELE,
    CHAM_MATER=CHMAT,
    CARA_ELEM=CARA,
    EXCIT=(
        _F(CHARGE=BC_0),
        _F(CHARGE=BC_1),
        _F(CHARGE=GRAVITY),
        _F(CHARGE=PRESSURE),
    ),
);

# ----- Derived fields -----
RESU = CALC_CHAMP(
    reuse=RESU,
    RESULTAT=RESU,
    CONTRAINTE=('EFGE_ELNO', 'SIEF_ELNO'),
    CRITERES=('SIEQ_ELNO',),
    FORCE='FORC_NODA',
);

# ----- Write MED results file -----
IMPR_RESU(
    FORMAT='MED',
    UNITE=80,
    RESU=_F(
        RESULTAT=RESU,
        NOM_CHAM=('DEPL', 'SIEQ_ELNO', 'EFGE_ELNO', 'FORC_NODA'),
    ),
);

# ----- Text table for EFGE_ELNO -----
TAB_EFFO = CREA_TABLE(
    RESU=_F(
        RESULTAT=RESU,
        NOM_CHAM='EFGE_ELNO',
        TOUT='OUI',
        NOM_CMP=('N', 'VY', 'VZ', 'MT', 'MFY', 'MFZ'),
    ),
);

IMPR_TABLE(
    TABLE=TAB_EFFO,
    UNITE=38,
    FORMAT='TABLEAU',
    SEPARATEUR=',',
);

# ----- Text table for DEPL -----
TAB_DEPL = CREA_TABLE(
    RESU=_F(
        RESULTAT=RESU,
        NOM_CHAM='DEPL',
        TOUT='OUI',
        NOM_CMP=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'),
    ),
);

IMPR_TABLE(
    TABLE=TAB_DEPL,
    UNITE=39,
    FORMAT='TABLEAU',
    SEPARATEUR=',',
);

# ----- Text table for FORC_NODA -----
TAB_REAC = CREA_TABLE(
    RESU=_F(
        RESULTAT=RESU,
        NOM_CHAM='FORC_NODA',
        TOUT='OUI',
        NOM_CMP=('DX', 'DY', 'DZ', 'DRX', 'DRY', 'DRZ'),
    ),
);

IMPR_TABLE(
    TABLE=TAB_REAC,
    UNITE=40,
    FORMAT='TABLEAU',
    SEPARATEUR=',',
);

# ----- Text table for SIEQ_ELNO -----
TAB_SIEQ = CREA_TABLE(
    RESU=_F(
        RESULTAT=RESU,
        NOM_CHAM='SIEQ_ELNO',
        TOUT='OUI',
        NOM_CMP=('VMIS',),
    ),
);

IMPR_TABLE(
    TABLE=TAB_SIEQ,
    UNITE=41,
    FORMAT='TABLEAU',
    SEPARATEUR=',',
);

FIN();